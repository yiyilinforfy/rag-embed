DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
# A pgvector/pgvector:pg16 container in the same pod (containers in a pod share 127.0.0.1).
# Tables are created on startup and the first sync fills an empty database:
# DATABASE_URL=postgresql+psycopg://rag:<password>@127.0.0.1:5432/rag
# Supabase: use the Session pooler string (IPv4, port 5432), not the direct db.xxx.supabase.co host (IPv6 only)
# or the transaction pooler on 6543 (breaks psycopg prepared statements):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Embedding: any OpenAI-compatible /v1/embeddings endpoint (Ollama by default).
# Must be the same model the index was built with; check with `uv run python -m scripts.check_embedding`.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# SiliconFlow hosted bge-m3:
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=BAAI/bge-m3

# LLM: any OpenAI-compatible /v1/chat/completions endpoint
# DeepSeek (paid, stronger):
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Local free via Ollama (M1 16GB: qwen3.5:9b is the strongest that fits well):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.5:9b
# LLM_REASONING_EFFORT=none

# Browser origins allowed to call the API (JSON list); add the production frontend domain
CORS_ORIGINS=["http://localhost:9527","http://127.0.0.1:9527"]

# VuePress docs
# The repo is private: the container needs a read-only token to clone it (docker/entrypoint.sh).
# GitHub > Settings > Developer settings > Fine-grained token, only this repo, Contents: Read-only.
DOCS_REPO_TOKEN=
DOCS_REPO_URL=https://github.com/virtualeconomy/vcloud-doc.git
DOCS_BRANCH=dev
DOCS_SUBDIR=zh
DOCS_BASE_URL=https://docs.vcloud.systems

# Docs sync interval in minutes (10080 = 7 days); 0 = off, use cron or the GitHub webhook instead
SYNC_INTERVAL_MINUTES=10080
# X-Admin-Token required by /api/ingest and /api/sync (empty = no check, local dev only)
ADMIN_TOKEN=
# Same secret as in GitHub repo Settings > Webhooks (empty = webhook disabled)
GITHUB_WEBHOOK_SECRET=

TOP_K=5
# Gates after Top-K, before the LLM. MIN_SCORE → vector cosine; RERANK_MIN_SCORE → rerank_score (0=off).
MIN_SCORE=0.45
# RERANK_MIN_SCORE=0.05

# Reranker: cross-encoder re-scoring of the vector candidates (SiliconFlow hosts BAAI/bge-reranker-v2-m3).
# Leave RERANK_ENABLED=false for local Ollama-only setups; the free SiliconFlow model needs an API key.
# RERANK_ENABLED=true
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=sk-...
# RERANK_MODEL=BAAI/bge-reranker-v2-m3   # free; "Pro/..." is billed and is rejected unless RERANK_ALLOW_PAID_MODEL=true
# RERANK_CANDIDATES=20
# RERANK_TIMEOUT_SECONDS=10
# RERANK_FALLBACK=vector
# SECTION_DEDUPE=auto
#   auto = keep one chunk per (source, heading) for plain vector search; allow several when reranking
#   on   = always keep one chunk per section
#   off  = never section-dedupe (content-identical chunks are still dropped)

# Hybrid: vector Top-N ∪ in-memory BM25 Top-N → Reranker → Top-K (helps exact terms like refundVsys).
# HYBRID_ENABLED=false
# BM25_CANDIDATES=20

# Per wallet address on /api/ask*: steady rate, short burst, daily cap, simultaneous streams
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=3
RATE_LIMIT_DAILY=200
MAX_CONCURRENT_STREAMS=2

# Multi-turn: how much recent conversation is sent to the LLM
HISTORY_MAX_MESSAGES=6
HISTORY_MAX_CHARS=6000
HISTORY_MESSAGE_MAX_CHARS=1500
